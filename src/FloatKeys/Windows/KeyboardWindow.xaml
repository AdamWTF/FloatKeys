<Window x:Class="FloatKeys.Windows.KeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloatKeys — Functional Keyboard" Width="840" Height="360"
        WindowStyle="None" ResizeMode="NoResize" Background="#20252E"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" Focusable="False"
        KeyboardNavigation.TabNavigation="None" KeyboardNavigation.ControlTabNavigation="None"
        KeyboardNavigation.DirectionalNavigation="None">
    <Border Background="#20252E" BorderBrush="#596273" BorderThickness="1" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>
            <TextBlock Text="FloatKeys · UK" Foreground="#CCD4E0" FontSize="16"
                       VerticalAlignment="Center" />
            <StackPanel x:Name="HeaderKeys" Orientation="Horizontal" HorizontalAlignment="Right" />
            <StackPanel x:Name="KeyRows" Grid.Row="1" Margin="0,4,0,0" />
            <TextBlock x:Name="Status" Grid.Row="2" Text="Focus a target field, then tap a key."
                       Foreground="#CCD4E0" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
        </Grid>
    </Border>
</Window>
