<Window x:Class="FloatKeys.Windows.KeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/FloatKeys;component/Resources/FloatKeys.ico"
        Title="FloatKeys — Keyboard" Width="840" Height="480"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" Focusable="False"
        KeyboardNavigation.TabNavigation="None" KeyboardNavigation.ControlTabNavigation="None"
        KeyboardNavigation.DirectionalNavigation="None">
    <Border Background="#20252E" BorderBrush="#596273" BorderThickness="1" CornerRadius="14" Padding="12">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False" PanningMode="Both">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar">
                    <Setter Property="MinWidth" Value="44" />
                    <Setter Property="MinHeight" Value="44" />
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </ScrollViewer.Resources>
            <Grid x:Name="LayoutRoot">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="44" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border x:Name="DragSurface" Background="Transparent" Cursor="SizeAll" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⠿" Foreground="#8796AB" FontSize="24" Margin="4,0,10,0" />
                            <TextBlock Text="FloatKeys · UK" Foreground="#CCD4E0" FontSize="16" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="HeaderKeys" Grid.Column="1" Orientation="Horizontal" />
                </Grid>
                <Grid x:Name="KeyRows" Grid.Row="1" Margin="0,4,0,0" />
                <TextBlock x:Name="Status" Grid.Row="2" Text="Focus a target field, then tap a key."
                           Foreground="#CCD4E0" FontSize="11" TextWrapping="Wrap" Margin="0,8,52,0" VerticalAlignment="Center" />
                <Border x:Name="ResizeSurface" Grid.Row="2" Width="44" Height="44" HorizontalAlignment="Right"
                        Background="#2C3442" CornerRadius="8" Cursor="SizeNWSE">
                    <Path Data="M 14,30 L 30,14 M 22,30 L 30,22" Stroke="#CCD4E0" StrokeThickness="2" />
                </Border>
                <Border x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed" Background="#252C38"
                        BorderBrush="#8796AB" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Launcher" Foreground="#F5F7FA" FontSize="18" Margin="0,0,0,8" />
                        <StackPanel x:Name="SizeSettings" Orientation="Horizontal" />
                        <StackPanel x:Name="OpacitySettings" Orientation="Horizontal" />
                        <TextBlock Text="Changes are saved automatically." Foreground="#CCD4E0" Margin="3,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Border>
</Window>
